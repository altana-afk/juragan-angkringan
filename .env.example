# Salin jadi .env.local (diabaikan git) untuk mengaktifkan mesin AI di studio objek editor peta.
# Isi yang perlu saja, lalu jalankan ulang: npm run editor

# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2

# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Tool pixel asset milikmu: endpoint yang menerima POST JSON { prompt, full_prompt, width, height, transparent }
# PIXEL_TOOL_URL=http://localhost:8000/api/generate
# PIXEL_TOOL_TOKEN=


# Salin menjadi .env lalu isi ID pengukuran Google Analytics 4 (contoh: G-ABC123XYZ).
# Kosongkan untuk mematikan analytics. Analytics tidak aktif di localhost maupun ?debug.
VITE_GA_ID=

# Akun & simpan di awan (Firebase). Kosongkan semua untuk menyembunyikan tombol Akun.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
